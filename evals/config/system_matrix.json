{
  "version": "0.3.0",
  "comparison_policy": {
    "one_primary_architecture_change_per_ablation": true,
    "same_case_set_required": true,
    "same_tool_fixtures_required": true,
    "record_model_revision": true,
    "record_prompt_hash": true,
    "candidate_registry": "evals/config/candidates.json"
  },
  "systems": [
    {
      "id": "baseline_single_pass",
      "kind": "atento_baseline",
      "enabled": true,
      "description": "Conversation history -> LLM -> response; no explicit planner/memory/tool controller."
    },
    {
      "id": "baseline_strong_prompt",
      "kind": "atento_baseline",
      "enabled": true,
      "description": "Single-pass model with best available system prompt; no external executive architecture."
    },
    {
      "id": "atento_no_memory",
      "kind": "ablation",
      "enabled": true,
      "disable": [
        "longitudinal_memory"
      ]
    },
    {
      "id": "atento_no_planner",
      "kind": "ablation",
      "enabled": true,
      "disable": [
        "planner"
      ]
    },
    {
      "id": "atento_no_critic",
      "kind": "ablation",
      "enabled": true,
      "disable": [
        "critic"
      ]
    },
    {
      "id": "atento_full",
      "kind": "candidate",
      "enabled": true,
      "description": "Full architecture defined by roadmap."
    },
    {
      "id": "psychat_upstream",
      "kind": "fork_spike",
      "enabled": false,
      "source_id": "SRC-PSYCHAT",
      "description": "Run upstream unchanged during ADR-000 spike.",
      "candidate_ref": "psychat_upstream"
    },
    {
      "id": "psychat_adapted",
      "kind": "fork_spike",
      "enabled": false,
      "source_id": "SRC-PSYCHAT",
      "description": "PsyChat with Atento Model Gateway, structured contracts, external session state and independent safety.",
      "candidate_ref": "psychat_wrapped"
    },
    {
      "id": "psychagent_reference",
      "kind": "reference_only",
      "enabled": false,
      "source_id": "SRC-PA",
      "description": "Research reference; do not copy into product while repository license is unclear."
    },
    {
      "id": "specialized_generator_soulchat",
      "kind": "model_adapter",
      "enabled": false,
      "source_id": "SRC-SOULCHAT",
      "description": "Evaluate as Response Generator backend through Model Gateway, not as executive architecture."
    },
    {
      "id": "specialized_generator_emollm",
      "kind": "model_adapter",
      "enabled": false,
      "source_id": "SRC-EMOLLM",
      "description": "Evaluate as Response Generator backend through Model Gateway."
    },
    {
      "id": "specialized_generator_mindchat",
      "kind": "model_adapter",
      "enabled": false,
      "source_id": "SRC-MINDCHAT",
      "description": "Model comparison only after checkpoint/license review."
    }
  ]
}
